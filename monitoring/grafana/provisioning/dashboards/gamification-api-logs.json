{
  "title": "API Logs",
  "uid": "gamification-api-logs",
  "tags": ["monitoring"],
  "schemaVersion": 39,
  "version": 7,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "level",
        "label": "Log Level",
        "type": "custom",
        "query": "DEBUG,INFO,WARN,ERROR",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": ".*"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Logs by Level",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(log_level) (count_over_time({service_name=\"gamification-api\"} | json | __error__=\"\" | regexp \"(?P<log_level>\\\\b(DEBUG|INFO|WARN|ERROR|FATAL)\\\\b)\" | logfmt | log_level=~\"(?i)${level:regex}\" [$__interval]))",
          "legendFormat": "{{level}}"
        }
      ],
      "legend": {
        "displayMode": "list",
        "placement": "bottom",
        "calcs": [],
        "showLegend": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "DEBUG"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "INFO"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "WARN"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ERROR"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "title": "Application Logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 19
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"gamification-api\"} | json | __error__=\"\"| regexp \"(?P<log_level>\\\\b(DEBUG|INFO|WARN|ERROR|FATAL)\\\\b)\"| logfmt| log_level=~\"(?i)${level:regex}\"| label_format detected_level=log_level | line_format \"{{.message}}\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": false,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ]
}